# VEYSL booking funnel — environment variables
# Copy to `.env.local` and fill in before enabling real enquiry delivery.
# Nothing here has credentials committed; see src/app/api/anfrage for the
# transport interface these env vars plug into.

# ---------------------------------------------------------------------------
# Enquiry delivery (src/app/api/anfrage)
# ---------------------------------------------------------------------------

# "console" (default) logs the formatted enquiry to stdout — dev/staging only,
# never use in production since it prints personal data to process logs.
# Once a real transport is implemented, switch to e.g. "resend" or "smtp".
BOOKING_TRANSPORT=console

# Inbox that receives the owner notification for every /anfrage enquiry
# (Veysel Durmuş). The general /kontakt form notifies a *different* address —
# it reads contact.email from the CMS (site-settings global, falling back to
# src/content/site.ts) instead, per docs/MAIL-SETUP.md's two-address setup.
BOOKING_NOTIFY_EMAIL=veyseldurmus92@gmail.com

# --- Once BOOKING_TRANSPORT=resend is implemented ---
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=booking@veysl.de

# --- Alternative: plain SMTP transport ---
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM_EMAIL=booking@veysl.de

# ---------------------------------------------------------------------------
# Admin panel & CMS (Payload) — payload.config.ts, src/payload/**
# ---------------------------------------------------------------------------

# Long random string used to sign admin session/auth tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required — Payload refuses to start without it. Never reuse across
# environments, and never commit the real value.
PAYLOAD_SECRET=

# Where the CMS database lives.
# Local dev (SQLite, default if unset): file:./veysl-cms.db (gitignored)
# Production (Postgres): postgres://user:password@host:5432/veysl — also
# requires swapping the sqliteAdapter for @payloadcms/db-postgres in
# payload.config.ts (see the comment above `db:` in that file; no
# collection/global/field needs to change).
DATABASE_URI=file:./veysl-cms.db

# Absolute URL Payload uses to build links back to itself (e.g. the admin
# panel's "view live" button). Defaults to http://localhost:3000 if unset.
# PAYLOAD_SERVER_URL=https://veysl.de

# Only needed to run the standalone `payload` CLI (migrate/migrate:create/
# generate:types/generate:importmap) — NOT needed to run the app itself
# (`npm run dev`/`next start`/`node server.js`), which resolves the config
# via the `@payload-config` tsconfig path alias instead. Required because
# `payload.config.mts` isn't one of the two filenames (`payload.config.js`/
# `.ts`) Payload's own CLI auto-searches for — see that file's own comment
# for why it's `.mts` at all.
# PAYLOAD_CONFIG_PATH=payload.config.mts

# ---------------------------------------------------------------------------
# Social feed (src/lib/social, src/components/social) — see docs/SOCIAL-FEED.md
# ---------------------------------------------------------------------------

# Optional. YouTube's public RSS feed (no API key needed) is queried by
# channel id, not by the public @handle. Leave unset and the server resolves
# it once at runtime from https://www.youtube.com/@veystunesofficial and
# caches the result in memory for 24h. Set this to skip that lookup entirely
# (e.g. on a host that blocks outbound requests to youtube.com HTML pages).
# YOUTUBE_CHANNEL_ID=

# Optional. Where cached first-party copies of Instagram/YouTube thumbnails
# are written to disk. Point this at a persistent volume/bind mount in
# production (same pattern as this project's other persistent data) so the
# cache survives restarts. Defaults to `.cache/social-media` under the repo
# root if unset.
# SOCIAL_MEDIA_CACHE_DIR=

# Both required together to enable the Instagram Graph API provider; without
# them, the site falls back to the curated list in src/content/social.ts.
# Getting these requires a Meta Business account + a Facebook Page linked to
# the Instagram account + a Meta app + a long-lived access token — see
# docs/SOCIAL-FEED.md for the exact steps. Do NOT use the old "Basic Display
# API" token format; that API was shut down by Meta in December 2024.
# INSTAGRAM_ACCESS_TOKEN=
# INSTAGRAM_BUSINESS_ACCOUNT_ID=

# ---------------------------------------------------------------------------
# Analytics (src/lib/analytics, src/components/analytics) — see docs/ANALYTICS.md
# ---------------------------------------------------------------------------

# Plausible — cookieless, no personal data, no consent banner required under
# DSGVO/TTDSG. This is the default/primary analytics tool for the whole
# site. Leave unset and nothing is loaded or sent anywhere at all (the
# NoopProvider takes over) — safe for local dev and PR previews. Set to the
# bare domain Plausible was configured with, e.g. "veysl.de".
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Only needed for a self-hosted Plausible instance; defaults to
# https://plausible.io/js/script.js (Plausible Cloud) if unset.
# NEXT_PUBLIC_PLAUSIBLE_SCRIPT_URL=

# Server-side Plausible Events API endpoint used by
# src/lib/analytics/server.ts (the ad-blocker-resilient counterpart to the
# client-side `enquiry_submitted` event) — defaults to
# https://plausible.io/api/event; override only for a self-hosted instance.
# PLAUSIBLE_EVENTS_API_URL=

# Optional, consent-gated (see docs/ANALYTICS.md) — never loads before the
# visitor explicitly picks "accept all" in the cookie banner. GA4
# Measurement ID, e.g. "G-XXXXXXXXXX". Leave unset to disable GA4 entirely —
# the consent banner itself only renders at all if this OR
# NEXT_PUBLIC_CLARITY_PROJECT_ID is set (nothing to consent to otherwise).
NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# Optional, consent-gated, session replay/heatmaps (Microsoft Clarity).
# REQUIRED before setting this in production: turn on "Mask all text and
# user input" (Strict mode) in the Clarity project dashboard under
# Settings → Privacy — the enquiry form collects names, emails and phone
# numbers, and that dashboard setting is the only reliable way to keep them
# out of a session replay. See docs/ANALYTICS.md.
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the checked-in template itself — it has no secrets, only
# documentation of which vars exist (see env.production.example, its
# equivalent for the production/.env file, which never matched `.env*` in
# the first place since it doesn't start with a literal dot).
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Payload CMS (payload.config.ts) — local SQLite dev database and uploaded
# media are runtime data, not source. Swap to Postgres in production (see
# the comment above `db:` in payload.config.ts) — nothing here is prod state.
/veysl-cms.db
/veysl-cms.db-*
/media

# Dev-server-Logdatei — Laufzeitartefakt, kein Quellcode.
dev.log

# Backups — same reason as in .dockerignore: these are SQLite dumps of real
# customer enquiries. A single `git add -A` on the server would commit them.
/backups

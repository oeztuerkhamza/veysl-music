# dj-veys.de — PRODUCTION environment template.
#
# Copy this to `.env` on the server (never commit the real file — `.env*` is
# already in .gitignore) and fill in every value marked <...>. See
# docs/DEPLOYMENT.md for exactly how/when to generate each secret.
#
# One .env, two jobs:
#   1. docker-compose.yml's `env_file: .env` passes every var in this file
#      into the running app container at runtime.
#   2. Docker Compose ALSO auto-loads a file literally named `.env` in the
#      project root to fill in `${VAR}` references inside docker-compose.yml
#      itself — that's how the NEXT_PUBLIC_* build args get from here into
#      the `docker compose build` step (see Dockerfile's top comment for why
#      only NEXT_PUBLIC_* vars need to be build args at all).
# These are two different mechanisms reading the same file; keep it in one
# place rather than maintaining a second copy for build args.

# ---------------------------------------------------------------------------
# Core app
# ---------------------------------------------------------------------------

# Long random secret Payload uses to sign admin session/auth tokens.
# MUST be >= 32 bytes, generated ON THE SERVER, and never reused across
# environments or committed anywhere. Generate with:
#   openssl rand -hex 32
# or, if openssl isn't available:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=<generate-on-server-see-comment-above>

# SQLite file inside the `veysl-data` named volume (mounted at /app/data —
# see Dockerfile/docker-compose.yml). Must be this exact absolute path;
# don't point it at a relative path here, since the container's cwd for
# `node server.js` doesn't reliably match payload.config.ts's own module
# directory (see that file's comment above `db:`).
DATABASE_URI=file:/app/data/veysl-cms.db

# Absolute URL of the production site — Payload uses this to build links
# back to itself (e.g. the admin panel's "view live" button).
PAYLOAD_SERVER_URL=https://dj-veys.de

# Only needed if you ever run the `payload` CLI by hand against this
# container (e.g. `docker compose run --rm app npx payload migrate:status`).
# `deploy/deploy.sh`'s own migration step already sets this itself — see
# payload.config.mts's own comment for why the config file is `.mts` and
# needs this at all.
# PAYLOAD_CONFIG_PATH=payload.config.mts

# Read by src/lib/seo.ts for canonical/OG URLs across the whole public site.
# Must match PAYLOAD_SERVER_URL above (same domain). This one is a
# NEXT_PUBLIC_* var — see the "one .env, two jobs" note above, it also has
# to be present at `docker compose build` time, not just at container start.
NEXT_PUBLIC_SITE_URL=https://dj-veys.de

# ---------------------------------------------------------------------------
# Enquiry delivery (src/app/api/anfrage) — see docs/MAIL-SETUP.md
# ---------------------------------------------------------------------------

# "console" is DEV-ONLY — it logs the full enquiry (name, email, phone) to
# stdout/docker logs, which is a personal-data leak into log storage in
# production. Do not deploy with this set to "console" — it writes the full
# enquiry, personal data included, to the process log.
#
# Both real transports are implemented in
# src/app/api/anfrage/_lib/transport.ts. For this deployment that means
# "smtp": mail is self-hosted on this same box (docs/MAIL-SELFHOSTED.md), and
# a local Postfix is reachable over SMTP, not over Resend's REST API.
# Uncomment the smtp block below and set this to `smtp` once the mail stack
# is up — before that, the site accepts enquiries into /admin but sends no
# notification.
BOOKING_TRANSPORT=console

# Owner inbox that receives every /anfrage booking enquiry.
BOOKING_NOTIFY_EMAIL=info@dj-veys.de

# --- Self-hosted mailserver (Postfix/Dovecot/Roundcube) ---
# The intended production setup — see docs/MAIL-SELFHOSTED.md. Authenticated
# submission over 587, never port 25.
# BOOKING_TRANSPORT=smtp
# SMTP_HOST=mail.dj-veys.de
# SMTP_PORT=587
# SMTP_USER=no-reply@dj-veys.de
# SMTP_PASS=
# SMTP_FROM_EMAIL=DJ Veys <no-reply@dj-veys.de>

# --- Alternative: Resend (implemented, see transport.ts) ---
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL=DJ Veys <no-reply@dj-veys.de>

# --- Mail health check ---
# Shared secret for GET /api/health/mail, which reports why mail is or is not
# going out (transport, credential presence, SMTP login, recent notification
# outcomes). Without it that endpoint answers 503 and reveals nothing.
#
# Generate:  openssl rand -hex 32
# Then add the SAME value as a GitHub repository secret named
# MAIL_HEALTH_TOKEN, so .github/workflows/mail-doctor.yml can read it on a
# schedule. Without that workflow, diagnosing a mail outage needs an SSH
# session, which is the problem it exists to remove.
#
# The endpoint never returns a secret, a customer address or a message body —
# addresses are reduced to their domain and secrets to a character count.
# MAIL_HEALTH_TOKEN=

# ---------------------------------------------------------------------------
# Social feed (optional — see docs/SOCIAL-FEED.md)
# ---------------------------------------------------------------------------
# Optional. Ohne diesen Wert löst der Provider die Kanal-ID einmal täglich
# über die öffentliche @handle-Seite auf. Gesetzt spart das den Umweg — und
# macht ihn unabhängig davon, wie YouTube seine Kanalseite gerade ausliefert.
# Für @djveysofficial:
# YOUTUBE_CHANNEL_ID=UCTQ2T7c-TQEZe9Dp1Se96oQ

# ⚠️ NICHT optional in Produktion, auch wenn der Rest dieses Blocks es ist.
# Ohne diesen Pfad landet der Vorschaubild-Cache im Container-Dateisystem und
# ist nach jedem Deploy verschwunden — die Seite verweist dann weiter auf
# /api/social/media/<id>, dahinter liegt nichts mehr, und der Besucher sieht
# kaputte Bilder statt Video-Vorschauen. Der Pfad muss auf das Volume
# `veysl-social-cache` zeigen (siehe docker-compose.yml).
SOCIAL_MEDIA_CACHE_DIR=/app/social-cache

# INSTAGRAM_ACCESS_TOKEN=
# INSTAGRAM_BUSINESS_ACCOUNT_ID=

# ---------------------------------------------------------------------------
# Analytics (optional — see docs/ANALYTICS.md). All NEXT_PUBLIC_* — see the
# "one .env, two jobs" note at the top; these must be set BEFORE the first
# `docker compose build`, changing them later needs a rebuild, not just a
# container restart.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=dj-veys.de
# NEXT_PUBLIC_PLAUSIBLE_SCRIPT_URL=
# PLAUSIBLE_EVENTS_API_URL=
# NEXT_PUBLIC_GA4_MEASUREMENT_ID=
# NEXT_PUBLIC_CLARITY_PROJECT_ID=

# ---------------------------------------------------------------------------
# Certificate issuance (deploy/setup-ssl.sh) — not read by the app itself
# ---------------------------------------------------------------------------
# CERTBOT_EMAIL=<owner-email-for-lets-encrypt-expiry-notices>

# ---------------------------------------------------------------------------
# Google reviews (optional — see docs and src/lib/reviews/google-places.ts)
# ---------------------------------------------------------------------------
# Server-side only. Restrict the key to the Places API in Google Cloud.
# GOOGLE_PLACES_API_KEY=
